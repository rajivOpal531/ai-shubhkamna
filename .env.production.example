# Frontend production build config. Copy to .env.production and fill in before `npm run build`.
# No secrets here (the profile/JWT secrets live only on the BACKEND). All values below are public config.

# --- Compositing + profile backend ---
# If you use one CloudFront distribution that routes /composite and /profile to the backend
# (recommended, same-origin, no CORS), leave these as relative paths:
VITE_COMPOSITE_URL=/composite
VITE_PROFILE_URL=/profile
# If instead the backend is on a separate host, use absolute HTTPS URLs, e.g.:
#   VITE_COMPOSITE_URL=https://api-shubhkamna.narendramodi.in/composite
#   VITE_PROFILE_URL=https://api-shubhkamna.narendramodi.in/profile
VITE_USE_MOCK_COMPOSITE=false
VITE_USE_MOCK_PROFILE=false

# --- NaMo integration URLs (UAT shown; swap for PROD when shared) ---
VITE_HOME_URL=https://birthday2025uat.narendramodi.in/
VITE_MEDIA_WALL_URL=https://birthday2025uat.narendramodi.in/MediaWall/frontend/index.html
VITE_CREATE_POST_BY_URL=https://sevauat-api.narendramodi.in/mediawall/bday2024/createPostByImageUrl
VITE_CREATE_POST_FILE_URL=https://sevauat-api.narendramodi.in/mediawall/bday2024/createPost
