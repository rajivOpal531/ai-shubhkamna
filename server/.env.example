# AWS credentials are read by boto3 from the environment. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=s3.narendramodi.in
S3_PREFIX=shubhkamna2026
S3_PUBLIC_READ_ACL=false

# Optional: public base URL for stored cards (e.g. a CDN in front of the bucket). When set, the
# service returns "<S3_PUBLIC_BASE_URL>/<S3_PREFIX>/<uuid>.jpg" instead of the raw S3 hostname.
S3_PUBLIC_BASE_URL=https://cdn.narendramodi.in

# Comma-separated list of browser origins allowed to call this service.
ALLOWED_ORIGINS=https://shubhkamnauat.narendramodi.in

# Two limits apply to POST /composite: per bearer token (RATE_LIMIT_PER_MINUTE) and per source IP
# (RATE_LIMIT_PER_IP_PER_MINUTE). Both must pass.

# Per-bearer-token (falling back to client IP) limit for POST /composite.
RATE_LIMIT_PER_MINUTE=10

# Per-source-IP ceiling across all tokens. The IP is the rightmost X-Forwarded-For entry
# (appended by the platform proxy) or the socket peer; see README "Rate limiting".
RATE_LIMIT_PER_IP_PER_MINUTE=30

# Optional: redis://... to share rate-limit counters across replicas; in-memory per process when empty.
RATE_LIMIT_STORAGE_URI=

# Optional. When set, the bearer token is forwarded via GET to this URL and any non-200 rejects the request.
JWT_VALIDATE_URL=

# rembg model name; isnet-general-use is baked into the Docker image.
REMBG_MODEL=isnet-general-use

# How many background-removal jobs may run at once. ISNet needs ~1 GB RSS each; keep this small.
MAX_CONCURRENT_COMPOSITES=2

# Storage backend: "s3" (default, production) or "local" (writes cards under LOCAL_STORAGE_DIR and
# serves them from this process at PUBLIC_BASE_URL/uploads/<id>.jpg — for local testing only).
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=local-uploads
PUBLIC_BASE_URL=http://localhost:8000

# How the service returns the finished card:
#   image (default) -> responds with the JPEG bytes; the frontend posts it as a file (Create Post 5.2).
#                      No storage/S3 needed in this mode (the media wall hosts the image).
#   url             -> uploads to STORAGE_BACKEND and returns { "imageUrl": ... } (Create Post 5.1).
RESPONSE_MODE=image

# Server-side profile decryption (GET /profile). Leave blank to disable the endpoint.
# These are shared secrets - keep them here only, never in the frontend bundle or the repo.
USER_JWT_TOKEN_SECRET_KEY=
PROFILE_DECRYPT_KEY=
PROFILE_DECRYPT_IV=
