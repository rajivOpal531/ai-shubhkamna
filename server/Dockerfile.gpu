# CUDA variant of ./Dockerfile for a GPU host (NVIDIA driver + NVIDIA Container Toolkit installed).
# Selected by deploy/docker-compose.gpu.yml; see DEPLOYMENT.md, "GPU host". Keep the runtime
# checks and the non-root setup in sync with ./Dockerfile.
#
# The CUDA major here MUST match the onnxruntime-gpu wheel in requirements-gpu.txt: PyPI wheels of
# onnxruntime-gpu >= 1.27 are built against CUDA 13 + cuDNN 9 (1.20-1.26 were CUDA 12). A mismatch
# does not fail the build: the CUDA provider just fails to load at runtime and rembg silently runs
# on CPU (REQUIRE_GPU=true, set by the compose override, turns that into a startup failure).
# CUDA 13 needs NVIDIA driver >= 580 on the host and supports Turing (T4 / g4dn) and newer.
FROM nvidia/cuda:13.0.3-cudnn-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    U2NET_HOME=/models \
    PATH=/opt/venv/bin:$PATH \
    # Make the CUDA / cuDNN shared libraries visible to onnxruntime's CUDA provider.
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

WORKDIR /srv

# Ubuntu 22.04 ships Python 3.10, which the app supports. Same native libraries as ./Dockerfile:
# libgl1/libglib2.0-0 for opencv (via rembg), libraqm0/libfribidi0/libharfbuzz0b for Indic text
# shaping, libheif1/libde265-0 for HEIC decode.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip \
      libgl1 libglib2.0-0 libraqm0 libfribidi0 libharfbuzz0b libheif1 libde265-0 \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv \
 && pip install --no-cache-dir --upgrade pip

COPY requirements-base.txt requirements-gpu.txt ./
RUN pip install --no-cache-dir -r requirements-gpu.txt

# Fail the build if the CUDA provider is not compiled into the installed onnxruntime, i.e. the CPU
# wheel slipped in. (Whether the GPU is actually reachable is a runtime question: see the
# "providers=" line the api logs at startup.)
RUN python -c "import onnxruntime as ort; p = ort.get_available_providers(); \
assert 'CUDAExecutionProvider' in p, f'onnxruntime has no CUDA provider: {p}'; print('providers', p)"

# Bake the model weights into the image so a cold container never downloads at request time.
# pooch downloads via a NamedTemporaryFile (mode 0600) and moves it into place, so the baked file is
# root-only; open it up or the non-root runtime user hits PermissionError while hash-checking it.
RUN python -c "from rembg import new_session; new_session('isnet-general-use')" \
 && chmod -R a+rX /models

# Fail the build if Pillow cannot see libraqm (text shaping for Indic scripts would silently break).
RUN python -c "from PIL import features; assert features.check('raqm'), 'libraqm not available to Pillow'"

# Fail the build if HEIC support is broken -- iOS gallery photos are HEIC, so a silent pillow-heif
# failure would make ~all iPhone uploads error. Round-trips a HEIC image to prove decode works.
RUN python -c "import io, pillow_heif; pillow_heif.register_heif_opener(); \
from PIL import Image; b=io.BytesIO(); Image.new('RGB',(32,32),(1,2,3)).save(b, format='HEIF'); \
im=Image.open(io.BytesIO(b.getvalue())); im.load(); assert im.size==(32,32); print('HEIC decode OK')"

COPY app ./app
COPY templates ./templates

# Drop root for everything the app does at runtime; /models and /srv were baked by root above and
# are made world-readable (see the chmod after the model bake), which is all the app needs.
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin appuser
ENV HOME=/tmp
USER 10001

EXPOSE 8000
# Same command as ./Dockerfile; see the comments there.
CMD ["sh", "-c", "exec uvicorn app.main:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
